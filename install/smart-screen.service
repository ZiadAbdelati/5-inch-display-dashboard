[Unit]
Description=5-inch smart screen dashboard daemon
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/default/smart-screen

[Service]
Type=simple
User=smartscreen
Group=smartscreen
SupplementaryGroups=dialout
WorkingDirectory=/opt/5-inch-screen
# Bind-mounted char devices inside the LXC come across mode 0000; fix perms
# at service start. Runs as root (+) even though the daemon itself runs as
# smartscreen. Uses -/ so a missing device doesn't block the service.
ExecStartPre=+-/bin/chgrp dialout /dev/smart-screen
ExecStartPre=+-/bin/chmod 660 /dev/smart-screen
ExecStart=/usr/local/bin/smart-screen-run
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/5-inch-screen/.playwright

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/5-inch-screen

[Install]
WantedBy=multi-user.target
