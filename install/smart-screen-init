#!/usr/bin/env bash
# Writes /etc/default/smart-screen and optional secrets, then (re)starts
# the smart-screen systemd service.
set -euo pipefail

APP_DIR="${SMART_SCREEN_APP_DIR:-/opt/5-inch-screen}"
SERVICE_USER="${SMART_SCREEN_USER:-smartscreen}"
CONFIG_FILE=/etc/default/smart-screen
SECRETS_DIR="$APP_DIR/secrets"
TOKEN_DEST="$SECRETS_DIR/ha_token"
AUTH_DEST="$SECRETS_DIR/auth_state.json"

usage() {
  cat <<'USAGE'
Usage:
  smart-screen-init --url URL [options]

Required:
  --url URL                 Dashboard URL to display

Options:
  --device PATH             Serial device inside container (default: /dev/smart-screen)
  --interval SECONDS        Refresh interval (default: 30)
  --quality N               JPEG quality 1..100 (default: 85)
  --ha-token TOKEN          Save this Home Assistant long-lived token
  --ha-token-file PATH      Copy token from a file into secrets
  --prompt-ha-token         Prompt securely for a Home Assistant token
  --auth-state PATH         Copy a Playwright auth-state JSON for cookie auth
  --set-session KEY=VALUE   Add sessionStorage item; may be repeated
  --interactive             Prompt for URL, interval, quality, and HA token
  --start-now               Restart and enable the service (default)
  --no-start                Only write config, don't touch service
  --help                    Show this message

Examples:
  smart-screen-init --url https://ha.example.com/dashboard --prompt-ha-token
  smart-screen-init --url http://grafana:3000/d/board --auth-state /tmp/state.json
USAGE
}

require_value() {
  local flag="$1" value="${2:-}"
  [[ -n "$value" ]] || { echo "missing value for $flag" >&2; exit 1; }
}

URL=
DEVICE=/dev/smart-screen
INTERVAL=30
QUALITY=95
HA_TOKEN=
HA_TOKEN_FILE=
PROMPT_TOKEN=0
INTERACTIVE=0
AUTH_STATE=
START_NOW=1
EXTRA_ARGS=()

while (($#)); do
  case "$1" in
    --url)             require_value "$1" "${2:-}"; URL="$2"; shift 2 ;;
    --device)          require_value "$1" "${2:-}"; DEVICE="$2"; shift 2 ;;
    --interval)        require_value "$1" "${2:-}"; INTERVAL="$2"; shift 2 ;;
    --quality)         require_value "$1" "${2:-}"; QUALITY="$2"; shift 2 ;;
    --ha-token)        require_value "$1" "${2:-}"; HA_TOKEN="$2"; shift 2 ;;
    --ha-token-file)   require_value "$1" "${2:-}"; HA_TOKEN_FILE="$2"; shift 2 ;;
    --prompt-ha-token) PROMPT_TOKEN=1; shift ;;
    --interactive)     INTERACTIVE=1; shift ;;
    --auth-state)      require_value "$1" "${2:-}"; AUTH_STATE="$2"; shift 2 ;;
    --set-session)     require_value "$1" "${2:-}"; EXTRA_ARGS+=(--set-session "$2"); shift 2 ;;
    --start-now)       START_NOW=1; shift ;;
    --no-start)        START_NOW=0; shift ;;
    --help|-h)         usage; exit 0 ;;
    *)                 echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ $INTERACTIVE -eq 1 ]]; then
  if [[ -z "$URL" ]]; then
    read -r -p "Dashboard URL: " URL
  fi
  read -r -p "Refresh interval in seconds [${INTERVAL}]: " input
  [[ -n "$input" ]] && INTERVAL="$input"
  read -r -p "JPEG quality 1-100 [${QUALITY}]: " input
  [[ -n "$input" ]] && QUALITY="$input"
  read -r -p "Serial device path [${DEVICE}]: " input
  [[ -n "$input" ]] && DEVICE="$input"
  if [[ -z "$HA_TOKEN" && -z "$HA_TOKEN_FILE" ]]; then
    read -r -s -p "Home Assistant token (blank to skip): " HA_TOKEN
    echo
  fi
fi

[[ -n "$URL" ]] || { echo "--url is required" >&2; usage >&2; exit 1; }

install -d -m 700 -o "$SERVICE_USER" -g "$SERVICE_USER" "$SECRETS_DIR"

if [[ $PROMPT_TOKEN -eq 1 && -z "$HA_TOKEN" ]]; then
  read -r -s -p "Home Assistant long-lived token: " HA_TOKEN
  echo
fi

if [[ -n "$HA_TOKEN" ]]; then
  printf '%s\n' "$HA_TOKEN" > "$TOKEN_DEST"
  chown "$SERVICE_USER:$SERVICE_USER" "$TOKEN_DEST"
  chmod 600 "$TOKEN_DEST"
elif [[ -n "$HA_TOKEN_FILE" ]]; then
  install -m 600 -o "$SERVICE_USER" -g "$SERVICE_USER" "$HA_TOKEN_FILE" "$TOKEN_DEST"
fi

if [[ -n "$AUTH_STATE" ]]; then
  install -m 600 -o "$SERVICE_USER" -g "$SERVICE_USER" "$AUTH_STATE" "$AUTH_DEST"
fi

{
  echo "# Generated by smart-screen-init on $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'SMART_SCREEN_APP_DIR=%q\n' "$APP_DIR"
  printf 'SMART_SCREEN_URL=%q\n'     "$URL"
  printf 'SMART_SCREEN_DEVICE=%q\n'  "$DEVICE"
  printf 'SMART_SCREEN_INTERVAL=%q\n' "$INTERVAL"
  printf 'SMART_SCREEN_QUALITY=%q\n' "$QUALITY"

  if [[ -f "$TOKEN_DEST" ]]; then
    printf 'SMART_SCREEN_HA_TOKEN_FILE=%q\n' "$TOKEN_DEST"
  else
    echo 'SMART_SCREEN_HA_TOKEN_FILE='
  fi

  if [[ -f "$AUTH_DEST" ]]; then
    printf 'SMART_SCREEN_AUTH_STATE=%q\n' "$AUTH_DEST"
  else
    echo 'SMART_SCREEN_AUTH_STATE='
  fi

  echo 'SMART_SCREEN_EXTRA_ARGS=('
  for arg in "${EXTRA_ARGS[@]}"; do
    printf '  %q\n' "$arg"
  done
  echo ')'
} > "$CONFIG_FILE"

chmod 644 "$CONFIG_FILE"

systemctl daemon-reload
systemctl enable smart-screen.service >/dev/null

if [[ $START_NOW -eq 1 ]]; then
  systemctl restart smart-screen.service
  systemctl --no-pager --full status smart-screen.service || true
else
  echo "Config written to $CONFIG_FILE"
  echo "Run: systemctl restart smart-screen.service"
fi
